    "songHowFindTitle": "Finding a song",
    "@songHowFindTitle": {
        "description": "SongLib guide section title"
    },
    "songHowFindBody": "Type in the search box at the top to find a song by its number, title or any words from its lyrics. Press S anywhere to jump to the box. The chips above the list narrow the songs down to one songbook.",
    "@songHowFindBody": {
        "description": "SongLib guide for finding songs"
    },
    "songHowReadTitle": "Reading a song",
    "@songHowReadTitle": {
        "description": "SongLib guide section title"
    },
    "songHowReadBody": "Pick a song in the list and its verses appear on the right, with the song title and songbook shown at the top of the window.",
    "@songHowReadBody": {
        "description": "SongLib guide for reading songs"
    },
    "songHowPresentTitle": "Presenting",
    "@songHowPresentTitle": {
        "description": "SongLib guide section title"
    },
    "songHowPresentBody": "Double-click a song, press Enter, or choose Present song from Quick Options to open it in the presenter. Step through the verses one slide at a time; change slide direction in Settings. Words are sized to fit the screen. The list button in the presenter title bar shows every verse in a sidebar, with the current verse highlighted. The sidebar starts open; press the button again to hide it.",
    "@songHowPresentBody": {
        "description": "SongLib guide for presenting songs"
    },
    "songHowKeysTitle": "Presenter keys",
    "@songHowKeysTitle": {
        "description": "SongLib guide section title"
    },
    "songHowKeysBody": "Right or Down arrow: next slide.\nLeft or Up arrow: previous slide.\n1 to 7: jump to that verse.\nC: jump to the chorus.\nL: jump to the last slide.\n- : make the text smaller.\n= : make the text bigger, as far as the longest verse still fits.\nEsc: close the presenter.",
    "@songHowKeysBody": {
        "description": "SongLib presenter keyboard shortcuts"
    },
    "songHowQuickTitle": "Quick Options",
    "@songHowQuickTitle": {
        "description": "SongLib guide section title"
    },
    "songHowQuickBody": "The Quick Options button at the bottom right collects what you can do with the selected song: copy its words, like it or present it.",
    "@songHowQuickBody": {
        "description": "SongLib guide for quick actions"
    },
    "songHowLikesTitle": "Likes",
    "@songHowLikesTitle": {
        "description": "SongLib guide section title"
    },
    "songHowLikesBody": "Songs you like are gathered under Likes in the sidebar so you can open your favourites quickly.",
    "@songHowLikesBody": {
        "description": "SongLib guide for liked songs"
    },
    "songHowBooksTitle": "Songbooks and updates",
    "@songHowBooksTitle": {
        "description": "SongLib guide section title"
    },
    "songHowBooksBody": "Your songbooks are stored on this device and refreshed in the background when you are online. To choose different songbooks, open Settings and use Songbooks.",
    "@songHowBooksBody": {
        "description": "SongLib guide for songbook storage and updates"
    },
    "bibleHowReadingTitle": "Reading",
    "@bibleHowReadingTitle": {
        "description": "BibleLib guide section title"
    },
    "bibleHowReadingBody": "Use the Bible button at the top to switch translation and the chapter button to jump to another chapter. Previous and Next at the bottom move chapter by chapter, or press Alt with the left or right arrow. The Up and Down arrow keys scroll the chapter. These keys only work while BibleLib is the open app.",
    "@bibleHowReadingBody": {
        "description": "BibleLib guide for reading"
    },
    "bibleHowTextTitle": "Text size and auto scroll",
    "@bibleHowTextTitle": {
        "description": "BibleLib guide section title"
    },
    "bibleHowTextBody": "Aa- and Aa+ in the title bar change the text size, or press - on your keyboard to make it smaller and = to make it bigger. Auto scroll at the bottom left scrolls the chapter for you; use the plus and minus beside it to set the speed, and touch the text to stop.",
    "@bibleHowTextBody": {
        "description": "BibleLib guide for text size and auto scroll"
    },
    "bibleHowParallelTitle": "Parallel Bibles",
    "@bibleHowParallelTitle": {
        "description": "BibleLib guide section title"
    },
    "bibleHowParallelBody": "Download more than one Bible and turn on the Multi-Bible reader in Quick Options to show your other translations under each verse.",
    "@bibleHowParallelBody": {
        "description": "BibleLib guide for parallel translations"
    },
    "bibleHowSelectTitle": "Selecting verses",
    "@bibleHowSelectTitle": {
        "description": "BibleLib guide section title"
    },
    "bibleHowSelectBody": "Click verses to select them. The bar at the top then lets you bookmark or highlight them, add a note to a single verse, or copy them. Press Esc to cancel the selection.",
    "@bibleHowSelectBody": {
        "description": "BibleLib guide for selecting verses"
    },
    "bibleHowSearchTitle": "Search",
    "@bibleHowSearchTitle": {
        "description": "BibleLib guide section title"
    },
    "bibleHowSearchBody": "Search looks through every verse of the Bible you choose and takes you straight to the result. Earlier searches are kept for next time.",
    "@bibleHowSearchBody": {
        "description": "BibleLib guide for Bible search"
    },
    "bibleHowHistoryTitle": "History",
    "@bibleHowHistoryTitle": {
        "description": "BibleLib guide section title"
    },
    "bibleHowHistoryBody": "History lists the chapters you read and the searches you made, so you can pick up where you stopped.",
    "@bibleHowHistoryBody": {
        "description": "BibleLib guide for history"
    },
    "bibleHowBookmarksTitle": "Bookmarks and Notes",
    "@bibleHowBookmarksTitle": {
        "description": "BibleLib guide section title"
    },
    "bibleHowBookmarksBody": "Everything you bookmark or write a note on is collected under Bookmarks and Notes in the sidebar, across all your Bibles.",
    "@bibleHowBookmarksBody": {
        "description": "BibleLib guide for bookmarks and notes"
    },
    "bibleHowOpenerTitle": "Scripture Opener",
    "@bibleHowOpenerTitle": {
        "description": "BibleLib guide section title"
    },
    "bibleHowOpenerBody": "Scripture Opener in the title bar opens a passage by typing its book, chapter and verse. Add several passages to a queue and open them one after another.",
